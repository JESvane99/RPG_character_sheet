# Flask Environment
# Options: development, production, testing
FLASK_ENV=development

# Secret key for session/CSRF protection
# IMPORTANT: Generate a strong random key for production
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-production-secret-key-here

# Database URL
# For SQLite (default):
# DATABASE_URL=sqlite:///CharSheet.db
# 
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/charsheet
DATABASE_URL=sqlite:///CharSheet.db
